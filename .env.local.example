# ---------- Supabase (required for production) ----------
# Project Settings -> API. Leave both keys blank to run in local/browser mode.
NEXT_PUBLIC_SUPABASE_URL=

# Older dashboards call this the "anon key"; newer ones call it the
# "publishable key". Fill ONE of the two lines below, not both.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only key: owner provisioning, admin panel, profile auth sync.
# Never use a NEXT_PUBLIC_ prefix for this.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Exclusive owner admin ----------
# Designated owner email. This alone never grants admin rights.
OWNER_ADMIN_EMAIL=shahriarniaztonmoy@gmail.com

# Optional TOTP second factor for /admin/login (base32, e.g. openssl rand -base32 20).
ADMIN_TOTP_SECRET=

# ---------- Session signing ----------
# Long random string, e.g. openssl rand -hex 32. JWT/session TTL is 7 days.
JWT_SECRET=

# ---------- Upstash Redis (cache, rate limits, one-time tickets) ----------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------- Optional transactional email ----------
# Supabase Auth emails are configured inside Supabase, not here.
RESEND_API_KEY=
EMAIL_FROM=B2 Sync <onboarding@resend.dev>

# ---------- Daily penalty check (optional) ----------
CRON_SECRET=change-me-to-a-long-random-string
